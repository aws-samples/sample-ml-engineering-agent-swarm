# =============================================================================
# .env.example  (COMMITTED TEMPLATE — placeholders only, NEVER real values)
# =============================================================================
# Unified config-externalization model (OSS-4b §6). Every account/org value
# resolves: ENV VAR  ->  SSM Parameter Store (/amlas/*)  ->  safe
# default. REQUIRED values have NO default and fail loudly if unset. See
# src/amlas/config/externalized.py (the single source of truth) and
# its CONFIG_KEYS registry; this template enumerates the same keys.
#
# Copy to .env and fill from SSM (after the CDK stacks are deployed):
#   AWS_PROFILE=<your-aws-profile> aws ssm get-parameters-by-path \
#     --path /amlas --recursive --region us-west-2 \
#     --query "Parameters[].[Name,Value]" --output text
#
# .env is gitignored. NEVER commit a real 12-digit account id, an AWS secret
# access key, or the Tavily tvly-... key. Only a profile name, region, resource
# names/ARNs (with <AWS_ACCOUNT_ID> placeholder), and a Secrets-Manager *secret
# id* belong in a populated .env. Loaded at package import by
# src/amlas/__init__.py.
#
# Env-prefix note (OSS-4b P3): the canonical prefix is AMLAS_. The legacy
# AMLAS_/AGENTICML_ prefixes are STILL HONORED for one release (the config
# layer reads AMLAS_* first, then falls back to the legacy name with a one-time
# deprecation warning) — existing .env files keep working; new ones should use
# AMLAS_*. The SSM namespace is /amlas (de-branded in P4).
#
# Marker key:  [REQUIRED] must be supplied   ·   [optional] safe default exists
# =============================================================================

# --- AWS identity / region --------------------------------------------------
# [REQUIRED] 12-digit account id of the deployment account. No default exists;
# the config layer raises MissingRequiredConfigError if unset. Placeholder only.
# scripts/setup.sh + scripts/teardown.sh read this as the account the SAFETY GATE
# asserts against (sts get-caller-identity MUST equal it before any mutation).
AMLAS_AWS_ACCOUNT_ID=<AWS_ACCOUNT_ID>
# [optional] AWS CLI profile. scripts/setup.sh/teardown.sh prefer AWS_PROFILE, then
# AMLAS_AWS_PROFILE. Set it to YOUR profile name to use it directly. LEAVE EMPTY to be
# prompted interactively (or, with --yes, to fall back to the default headless profile that
# maps to the target account WITHOUT a browser login — see docs/deploy/03-one-click-setup.md).
# Do NOT leave a <...> placeholder here: it is used LITERALLY and will fail the account
# safety gate. Empty = prompt/default; a real name = use it.
AWS_PROFILE=
# Leave selectors blank to use --region, the selected profile metadata, or the
# setup prompt. Required services and configured model profiles are preflighted.
AWS_REGION=
AWS_DEFAULT_REGION=
# [optional] Mirror of AWS_PROFILE consumed by the setup/teardown scripts (belt-and-
# suspenders; either name works). LEAVE EMPTY to be prompted / use the default headless
# profile — a <...> placeholder would be used literally and fail the safety gate.
AMLAS_AWS_PROFILE=
AMLAS_AWS_REGION=

# --- One-click deploy scripts (scripts/setup.sh / teardown.sh) ---------------
# The scripts read AMLAS_AWS_ACCOUNT_ID / AWS_PROFILE(+AMLAS_AWS_PROFILE) /
# AWS_REGION(+AMLAS_AWS_REGION) / TAVILY_SECRET_ID / AMLAS_TAVILY_API_KEY /
# AMLAS_KMS_KEY_ARN from THIS file (config-first; empty => prompt/default; --yes => default).
# The proven 9-stack DEPLOY ORDER and the built-in defaults live in
# scripts/lib/deploy_common.sh (AMLAS_STACKS_DEPLOY_ORDER, DEFAULT_AWS_*). They are proven
# constants — override via .env only if you know why; never `cdk deploy --all`.

# --- CDK deploy env + cost-allocation tags (infra/cdk_stacks/_tags.py, app.py) -----
# [optional] deployment environment. "prod" flips LakeStack (and other data stacks)
# to RETAIN removal policy (WA-21) so a teardown cannot strand data; "dev"/"test"
# keeps DESTROY+auto_delete for clean per-run teardown. Default: dev.
AMLAS_ENV=dev
# [optional] cost-allocation tags stamped on every taggable resource (WA-12) for
# chargeback. Safe OSS defaults — no org-specific value. See _tags.py.
AMLAS_COST_PROJECT=amlas
AMLAS_COST_OWNER=amlas-ml-platform
# [optional] OTEL message-content capture (WA-04 privacy seam). Redact-by-default
# (OFF/empty). Set to true/1/yes/on ONLY after a data-governance decision on
# prompt/response retention + redaction. Consumed at infra/app.py.
AMLAS_CAPTURE_CONTENT=

# --- Bedrock execution default (TUI and ML work = Sonnet 5.5) ---
# Separate reviewers/judges default to GPT-6.1 Sol via AMLAS_MODEL_REVIEWER.
# Native 1M context; no legacy context beta or temperature parameter is required.
# Existing explicit .env/overlay values stay in effect; update them to migrate.
AMLAS_CHAT_MODEL=global.anthropic.claude-sonnet-5-5

# --- Medallion lake (SSM /amlas/lake-*) --------------------------
# [REQUIRED for lake ops] lake bucket NAME (no s3:// prefix). Placeholder only:
AMLAS_LAKE_BUCKET=<LAKE_BUCKET>
AMLAS_S3_BUCKET=<LAKE_BUCKET>
AMLAS_LAKE_CATALOG=glue
AMLAS_LAKE_SILVER_PREFIX=s3://<LAKE_BUCKET>/silver/
AMLAS_LAKE_GOLD_PREFIX=s3://<LAKE_BUCKET>/gold/
AMLAS_LAKE_BRONZE_PREFIX=s3://<LAKE_BUCKET>/bronze/
# [optional] Glue Data Catalog database name (SSM /amlas/glue-database).
AMLAS_GLUE_DATABASE=<GLUE_DATABASE>

# --- SageMaker MLOps (SSM /amlas/model-package-group) ------------
# [optional] resource NAMES (safe non-account defaults). SageMaker forbids
# underscores in the package-group name (hyphenated).
AMLAS_MODEL_PACKAGE_GROUP=amlas-models
AMLAS_FEATURE_STORE_DB=amlas_features
AMLAS_MONITOR_SCHEDULE=hourly
# [optional] Athena workgroup for feature-store point-in-time queries.
AMLAS_ATHENA_WORKGROUP=primary

# --- AgentCore cloud dispatch (SSM /amlas/agentcore-runtime-arn) ---
# [optional] Runtime ARN. FIX-12: ship EMPTY (never an ARN-shaped placeholder —
# a non-empty <...> value shadows SSM resolution and AccessDenies on invoke).
# Resolved from SSM /amlas/agentcore-runtime-arn when blank. Real example:
# arn:aws:bedrock-agentcore:us-west-2:<acct>:runtime/amlas-<id>
AGENTCORE_RUNTIME_ARN=
# [optional] ECR image URI for the runtime container (SSM /amlas/runtime-ecr-uri).
AMLAS_RUNTIME_ECR_URI=

# --- Async-training session bucket (SSM /amlas/session-bucket) ---
# Leave BLANK to resolve from SSM /amlas/session-bucket (published by the stack).
# A verbatim <SESSION_BUCKET> placeholder is treated as unset (FIX-12), but blank
# is cleaner. Set explicitly only to override the stack-published bucket.
AMLAS_SESSION_BUCKET=

# --- Bedrock Guardrails (WA-02; SSM /amlas/guardrail-*) -----------
# [optional] empty disables in-band guardrails (offline-safe NO-OP default).
AMLAS_GUARDRAIL_ID=<GUARDRAIL_ID>
AMLAS_GUARDRAIL_VERSION=DRAFT

# --- KMS (WAFR seam; SSM /amlas/kms-key-arn) ----------------------
# [optional] BYO CMK ARN. LEAVE EMPTY (default) so CDK mints a per-stack
# rotation-enabled CMK — the secure default. Only set this to a REAL, existing key
# ARN if you want every data stack to import ONE shared/BYO CMK. Do NOT set it to a
# placeholder: infra/app.py now rejects any value containing "<" or not starting with
# "arn:aws:kms:" (a placeholder here previously caused DetectionsStack to fail CFN
# KmsKeyId validation — see docs/deploy/02-fixes-applied.md F15).
# Example of a real value (DO NOT copy verbatim): arn:aws:kms:us-west-2:111122223333:key/abcd-...
AMLAS_KMS_KEY_ARN=

# --- VPC networking (WAFR WA-05; SSM /amlas/vpc-id) ---------------
# [optional] only needed for PRIVATE runtime/training network mode.
AMLAS_VPC_ID=<VPC_ID>
AMLAS_PRIVATE_SUBNET_IDS=<SUBNET_ID_1>,<SUBNET_ID_2>
# [optional] runtime network mode (WA-05 seam): PUBLIC (default) | PRIVATE.
AMLAS_RUNTIME_NETWORK_MODE=PUBLIC

# --- Budget caps (control-plane spend governance; safe-blocking 0.0 default) --
# [optional] hard/soft USD caps for auto-approved spend.
AMLAS_MAX_AUTO_COST_USD=10
AMLAS_ABSOLUTE_BUDGET_USD=50

# --- Sandbox / trusted-model (SEC seams) ------------------------------------
# [optional] code-interpreter network egress (default OFF / unset).
AMLAS_SANDBOX_EGRESS=
# [optional] trusted root dir for pickle model-artifact loads (SEC-A07).
AMLAS_TRUSTED_MODEL_ROOT=<TRUSTED_MODEL_ROOT>

# --- Tavily research source — SECRET *ID* only (NEVER the key) --------------
# [optional] Secrets Manager secret id; the value lives in Secrets Manager.
# SecretsStack IMPORTS this id (does NOT create it); scripts/setup.sh creates-or-
# updates the secret before deploy (H7/F11) and scripts/teardown.sh removes it.
TAVILY_SECRET_ID=amlas/tavily-api-key
# [optional] The ACTUAL Tavily API key value (tvly-...). Read ONLY by
# scripts/setup.sh to seed the Secrets Manager secret above. LEAVE BLANK to use a
# documented DUMMY placeholder (the 9-stack deploy succeeds with the placeholder;
# set the real key out-of-band later via `aws secretsmanager put-secret-value`).
# NEVER commit a real tvly-... value — .env is gitignored, .env.example is NOT.
AMLAS_TAVILY_API_KEY=

# --- Backend-port selectors (doc 05 §4.3/§8.5; M0 seam) ---------------------
# The BackendRegistry resolves each port → adapter: hard-steering pin →
# explicit *_BACKEND env → auto (scale + budget + offline).
# AMLAS_BACKENDS_OFFLINE makes the auto path use the LOCAL adapter (no AWS).
LAKE_BACKEND=s3medallion
EVALUATION_BACKEND=arbiter          # deterministic Arbiter (ADR-003 — never delegated)
EXPERIMENT_TRACKING_BACKEND=local   # local leaderboard
# Set AMLAS_BACKENDS_OFFLINE=1 to force every auto resolution to the local adapter.

# Optional isolated deployment; use --deployment-prefix to choose it in setup.
AMLAS_DEPLOYMENT_PREFIX=amlas
AMLAS_SSM_PREFIX=
