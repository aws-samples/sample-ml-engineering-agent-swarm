# =============================================================================
# Agentic-ML — Agent-swarm layer template (.env.swarm.example)
#                                              [COMMITTED — placeholders only]
# =============================================================================
# Copy to .env.swarm (gitignored) to tune the leads/sub-agent swarm. THIN
# OVERLAY over the shared-base root .env. Loaded at swarm-assembly time by
# orchestrator.Orchestrator.__init__ via load_layered_env("swarm") AFTER the
# root .env; a shell export still wins.
# Precedence: shell export > .env.swarm > root .env > .agenticml.yaml defaults.
# NO secrets — only budget/retreat knobs, memory/KB toggles, steering defaults.
#
# Env prefix (OSS-4b P3): canonical names use AMLAS_. Legacy AGENTICML_/AMLAS_
# names are still honored for one release (a DeprecationWarning is emitted).
# =============================================================================

# --- Iteration / budget knobs (config.runtime.Budgets via load_config) ---
AMLAS_MAX_RETREATS=3
AMLAS_WALL_CLOCK_MIN=30
AMLAS_TOOL_CALL_LIMIT=200
AMLAS_TRIALS=50

# --- Memory / KB toggles (MEMORY_ID gates the MemoryHookProvider) ---
# MEMORY_ID=<agentcore-memory-id>   # leave unset to run without Memory hooks
AMLAS_KB_ENABLED=1

# --- Steering defaults honored by /impute /synth /dqscan ---
AMLAS_STEERING_DEFAULT_DOMAIN=manufacturing

# --- Backend-port selectors (doc 05 §4.3/§8.5; M0 seam) — LOCAL-leaning overlay -
# The swarm dev overlay leans LOCAL/in-process for cheap, offline iteration: the
# deterministic Arbiter (local by design), the local leaderboard, and the
# in-process training/lake adapters. Flip any to its managed adapter (e.g.
# TRAINING_BACKEND=sagemaker) to send that port's work to AWS without code change.
# AMLAS_BACKENDS_OFFLINE=1 forces every auto resolution to the local adapter.
TRAINING_BACKEND=local
LAKE_BACKEND=localfs
EVALUATION_BACKEND=arbiter
MODEL_REGISTRY_BACKEND=jsonfile
PIPELINE_BACKEND=local
MONITORING_BACKEND=otel
EXPERIMENT_TRACKING_BACKEND=local
