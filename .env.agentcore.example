# =============================================================================
# Agentic-ML — AgentCore/Strands layer template (.env.agentcore.example)
#                                              [COMMITTED — placeholders only]
# =============================================================================
# Copy to .env.agentcore (gitignored) for the AgentCore runtime + Strands agent
# build. THIN OVERLAY over the shared-base root .env. Loaded by app.py (runtime
# entrypoint) and _build._build_bedrock_model (real-model path) via
# load_layered_env("agentcore") AFTER the root .env; a shell export still wins.
# Precedence: shell export > .env.agentcore > root .env > .agenticml.yaml defaults.
# NO secrets — only runtime ARN (non-secret), model tiers, telemetry toggles.
#
# Env prefix (OSS-4b P3): canonical names use AMLAS_. Legacy AGENTICML_/AMLAS_
# names are still honored for one release (a DeprecationWarning is emitted).
# =============================================================================

# --- AgentCore runtime ARN --------------------------------------------------
# FIX-12: ship EMPTY (never an ARN-shaped <...> placeholder — a non-empty
# placeholder shadows SSM resolution and AccessDenies on invoke). Resolved from
# SSM /amlas/agentcore-runtime-arn when blank. Real example:
# arn:aws:bedrock-agentcore:<AWS_REGION>:<acct>:runtime/amlas-<id>
AGENTCORE_RUNTIME_ARN=

# --- Per-role Bedrock model tiers (config.runtime.load_config reads these) ---
# Sonnet 5.5 executes ML work; GPT-6.1 Sol is the separate reviewer/judge.
# Existing explicit .env/overlay choices stay in effect until updated.
AMLAS_MODEL_PLANNER=global.anthropic.claude-sonnet-5-5
AMLAS_MODEL_REVIEWER=us.openai.gpt-6.1-sol
AMLAS_MODEL_SPECIALIST=global.anthropic.claude-sonnet-5-5
AMLAS_MODEL_BOUNDED=global.anthropic.claude-sonnet-5-5
AMLAS_MODEL_FINETUNE=global.anthropic.claude-sonnet-5-5

AMLAS_AWS_REGION=

# --- Strands / OpenTelemetry telemetry toggles ---
OTEL_PYTHON_DISABLED_INSTRUMENTATIONS=threading
STRANDS_OTEL_ENABLE_CONSOLE_EXPORT=false

# --- Backend-port selectors (doc 05 §4.3/§8.5; M0 seam) — AWS PROD overlay -----
# The hosted AgentCore runtime targets the managed AWS adapters: training on
# SageMaker, the medallion lake on S3, the Model Registry / Pipelines / Model
# Monitor / Clarify / Feature Store on SageMaker. The deterministic Arbiter is
# never delegated (ADR-003). The BackendRegistry reads these directly.
TRAINING_BACKEND=sagemaker
MODEL_REGISTRY_BACKEND=sagemaker
PIPELINE_BACKEND=sagemaker
MONITORING_BACKEND=sagemaker
EXPLAINABILITY_BACKEND=clarify
FEATURE_STORE_BACKEND=sagemaker
LAKE_BACKEND=s3medallion
EVALUATION_BACKEND=arbiter
EXPERIMENT_TRACKING_BACKEND=local
