# =============================================================================
# Agentic-ML — TUI layer template (.env.tui.example)
#                                              [COMMITTED — placeholders only]
# =============================================================================
# Copy to .env.tui (gitignored) to override TUI-scoped settings. THIN OVERLAY
# over the shared-base root .env. Loaded by tui/app.py:run via
# load_layered_env("tui") AFTER the root .env; a shell export still wins.
# Precedence: shell export > .env.tui > root .env > .agenticml.yaml defaults.
# NO secrets belong here — only TUI model/UX toggles.
#
# Env prefix (OSS-4b P3): canonical names use AMLAS_. Legacy AGENTICML_/AMLAS_
# names are still honored for one release (a DeprecationWarning is emitted).
# =============================================================================

# --- Bedrock model for the tool-bound TUI agent ---
# Explicit old .env/.env.tui selections stay in effect until updated.
AMLAS_CHAT_MODEL=global.anthropic.claude-sonnet-5-5

# --- TUI UX toggles ---
AMLAS_TUI_THEME=dark
AMLAS_TUI_SHOW_TOOL_TRACE=1

# --- AWS-first-by-default posture (user directive 2026-07-12) ---
# "Ensure everything our TUI does kicks off via the AWS account by default, not
# locally." At startup (tui/app.py:run, next to the stale bearer-token fix) the TUI
# performs an EXPLICIT, logged AWS-first affirmation: when this flag is ON AND the
# process is not running with AMLAS_OFFLINE enabled, it verifies the
# backend auto-selection resolves to the AWS defaults (SageMaker/Clarify/S3), not
# local — turning the previously-implicit posture into a verified invariant.
#
# AMLAS_TUI_FORCE_AWS — DEFAULT ON. The affirmation is verification-only: it NEVER
#   mutates the environment or pins a *_BACKEND selector, and it is an explicit no-op
#   while offline mode is active.
#   Set to 0/false/no/off to SKIP the affirmation (an escape hatch — it does NOT flip
#   the TUI to local; explicit *_BACKEND env vars still override the auto path either way).
AMLAS_TUI_FORCE_AWS=1

# --- Agent remote-path reach (Feature 1: filesystem & remote-path tools) ---
# The chat agent's file/dataset tools (read_file, describe_dataset, load_dataset, …)
# transparently accept local paths, s3:// URIs, and http(s):// URLs via the shared
# amlas.tools.pathref seam.
#
# AMLAS_AGENT_REMOTE_FETCH — gate remote (S3/HTTP) reads. DEFAULT ON (AWS-first: S3
#   IS the AWS account, resolved via the same AWS profile the rest of the TUI uses).
#   Set to 0/false/no/off to force LOCAL-ONLY (remote refs return a clear disabled
#   error; local paths keep the sandbox behavior unchanged).
AMLAS_AGENT_REMOTE_FETCH=1
#
# AMLAS_AGENT_HTTP_ALLOW_HOSTS — optional comma-separated host allow-list for
#   http(s):// reads. EMPTY (default) = allow any PUBLIC host, but the MANDATORY SSRF
#   guard ALWAYS applies (link-local/loopback/private/metadata 169.254.169.254 etc.
#   are rejected regardless). HTTP is anonymous-only — no Authorization header is ever
#   attached (presigned S3 URLs arrive as https:// and work anonymously).
# AMLAS_AGENT_HTTP_ALLOW_HOSTS=data.example.com,files.example.com
